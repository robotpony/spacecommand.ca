# Database Configuration
# Option 1: Use DATABASE_URL (recommended for production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spacecommand_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spacecommand_test

# Option 2: Individual variables (legacy, will be deprecated)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spacecommand_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=20

# Redis Configuration  
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server Configuration
PORT=3000
NODE_ENV=development

# Security
JWT_SECRET=your-secret-key-here-change-in-production-at-least-32-characters-long
SESSION_SECRET=your-session-secret-here-change-in-production

# Email Configuration
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=SpaceCommand Central <noreply@spacecommand.ca>
EMAIL_REPLY_TO=support@spacecommand.ca

# Authentication Settings
REGISTRATION_MODE=open
REQUIRE_EMAIL_VERIFICATION=true
MAX_UNIVERSES_PER_USER=3
PASSWORD_MIN_LENGTH=12
BCRYPT_ROUNDS=12
SESSION_EXPIRY_HOURS=24
PERSISTENT_SESSION_DAYS=30
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_PASSWORD_RESETS=1
LOCKOUT_DURATION_MINUTES=15
APP_URL=http://localhost:3000

# Logging
LOG_LEVEL=debug
LOG_QUERIES=false

# Game Configuration
TURN_DURATION_HOURS=2
MAX_ACTION_POINTS=10
STARTING_CREDITS=50000