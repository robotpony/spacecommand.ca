# Database Configuration
# Option 1: Use DATABASE_URL (recommended for production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spacecommand_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spacecommand_test

# Option 2: Individual variables (legacy, will be deprecated)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spacecommand_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=20

# Redis Configuration  
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server Configuration
PORT=3000
NODE_ENV=development

# Security
JWT_SECRET=your-secret-key-here-change-in-production
SESSION_SECRET=your-session-secret-here-change-in-production

# Logging
LOG_LEVEL=debug
LOG_QUERIES=false

# Game Configuration
TURN_DURATION_HOURS=2
MAX_ACTION_POINTS=10
STARTING_CREDITS=50000